# Copy to .env.local for local development. Never commit real values.
# The deployed site sets these as server-side environment variables in the
# hosting provider's dashboard (e.g. Vercel Project Settings > Environment
# Variables) — never exposed to the browser.

# Your class gateway key (cg_...). Required.
GATEWAY_API_KEY=

# Optional overrides — only set these if your gateway's OpenRouter base URL
# or the Claude model id it exposes differs from the defaults in lib/anthropic.ts.
# GATEWAY_BASE_URL=https://174.138.16.223/openrouter/v1
# GATEWAY_MODEL=anthropic/claude-3.5-sonnet
